rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Username lookup is public so a user can sign in without entering an email.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.authEmail is string;
      allow update, delete: if false;
    }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username is string;
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
    // Friend requests: sender writes to recipient's incoming folder; recipient may read/delete.
    match /friendRequests/{recipientUid}/incoming/{senderUid} {
      allow create: if signedIn() && request.auth.uid == senderUid
        && request.resource.data.senderUid == senderUid
        && request.resource.data.recipientUid == recipientUid
        && request.resource.data.senderName is string;
      allow read, delete: if signedIn() && request.auth.uid == recipientUid;
      allow update: if false;
    }
    // A friendship is created by the recipient while accepting the incoming request.
    match /friendships/{friendshipId} {
      allow get, list: if signedIn()
        && resource.data.memberUids is list
        && resource.data.memberUids.size() == 2
        && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.recipientUid == request.auth.uid
        && request.resource.data.senderUid is string
        && request.resource.data.senderUid != request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.senderUid in request.resource.data.memberUids
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames[request.auth.uid] is string
        && request.resource.data.memberNames[request.resource.data.senderUid] is string
        && exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid)/incoming/$(request.resource.data.senderUid));
      allow update, delete: if false;
    }
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create, update: if signedIn()
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberNames is map
        && exists(/databases/$(database)/documents/friendships/$(conversationId))
        && get(/databases/$(database)/documents/friendships/$(conversationId)).data.memberUids == request.resource.data.memberUids;
      match /messages/{messageId} {
        function conversationMember() {
          return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberUids;
        }
        allow read: if conversationMember();
        allow create: if conversationMember()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.senderName is string;
        allow update, delete: if false;
      }
    }
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames[request.auth.uid] is string
        && request.resource.data.maxPlayers is int
        && request.resource.data.maxPlayers >= 2
        && request.resource.data.maxPlayers <= 20
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.game is string
        && request.resource.data.description is string;
      allow update: if signedIn() && (
        (resource.data.hostUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'closed')
        ||
        (resource.data.hostUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastHeartbeat', 'isLive'])
          && request.resource.data.lastHeartbeat is timestamp
          && request.resource.data.isLive is bool)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
          && request.resource.data.status == resource.data.status
          && request.resource.data.members is list
          && request.resource.data.members.size() <= resource.data.maxPlayers
          && request.resource.data.memberNames is map
          && request.resource.data.memberNames.keys().size() == request.resource.data.members.size()
          && request.resource.data.memberNames.keys().hasAll(request.resource.data.members)
          && (
            (request.resource.data.members.size() == resource.data.members.size() + 1
              && request.resource.data.members.hasAll(resource.data.members)
              && request.resource.data.members.hasAll([request.auth.uid])
              && !(request.auth.uid in resource.data.members)
              && request.resource.data.memberNames[request.auth.uid] is string)
            ||
            (request.resource.data.members.size() == resource.data.members.size() - 1
              && resource.data.members.hasAll(request.resource.data.members)
              && resource.data.members.hasAll([request.auth.uid])
              && !(request.auth.uid in request.resource.data.members)
              && !(request.auth.uid in request.resource.data.memberNames.keys()))
          ))
      );
      allow delete: if false;
      match /messages/{messageId} {
        function roomMember() {
          return signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
        }
        allow read: if roomMember();
        allow create: if roomMember()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }
    }
  }
}